{
  "name": "btutotons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "generate": "tsx scripts/generate-redirects.ts && tsx scripts/generate-headers.ts",
    "build": "pnpm generate && next build && tsx scripts/alias-encoded-assets.ts",
    "build:preview": "NEXT_PUBLIC_BTUTOTONS_PREVIEW=1 pnpm build",
    "budget": "tsx scripts/check-js-budget.ts",
    "preview": "wrangler dev --port 4173",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:preview": "NEXT_PUBLIC_BTUTOTONS_PREVIEW=1 playwright test",
    "lhci": "lhci autorun",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  }
}
